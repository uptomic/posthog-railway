<?xml version="1.0"?>
<clickhouse>
    <!-- /var/lib/clickhouse is a persistent volume; immutable UDF executables
         must remain visible when that volume masks the image's data directory. -->
    <user_scripts_path replace="replace">/opt/posthog/user_scripts/</user_scripts_path>

    <!-- Railway containers have a bounded PID budget. Keep enough scheduler
         capacity for PostHog's Kafka engines without allowing ClickHouse's
         global pool ceiling to become an eagerly allocated scheduler pool. -->
    <background_schedule_pool_size>128</background_schedule_pool_size>
    <background_message_broker_schedule_pool_size>128</background_message_broker_schedule_pool_size>
    <!-- Production background occupancy is ~480 global threads. The former
         512 ceiling saturated under observed production query load.
         Bound both workers and admitted jobs; retain PID headroom below 1000. -->
    <max_thread_pool_size>640</max_thread_pool_size>
    <thread_pool_queue_size>640</thread_pool_queue_size>

    <!-- The official container adds both IPv4 and IPv6 wildcard listeners.
         Railway's network namespace exposes them as the same socket. -->
    <listen_host replace="replace">0.0.0.0</listen_host>

    <!-- TLS terminates at Railway. PostHog's development ClickHouse config
         declares secure listeners but does not ship their certificate files. -->
    <https_port remove="remove" />
    <tcp_port_secure remove="remove" />
    <openSSL remove="remove" />

    <logger>
        <console>true</console>
    </logger>
</clickhouse>
