<?xml version="1.0"?>
<clickhouse>
    <profiles>
        <default>
            <!-- A conservative default, not a constraint on explicit queries. -->
            <max_threads>8</max_threads>
        </default>
    </profiles>
    <!-- PostHog's local-single dictionaries use SOURCE(CLICKHOUSE(USER
         'default' ...)). The official entrypoint removes that user whenever a
         named CLICKHOUSE_USER is configured. Restore only the local dictionary
         reader; all network clients continue to use the authenticated named
         user defined here. -->
    <users>
        <default>
            <password remove="remove" />
            <no_password />
            <networks replace="replace">
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
            <profile>readonly</profile>
            <quota>default</quota>
            <access_management>0</access_management>
        </default>
        <clickhouse>
            <password from_env="CLICKHOUSE_PASSWORD" />
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
            <show_named_collections>1</show_named_collections>
        </clickhouse>
    </users>
</clickhouse>
